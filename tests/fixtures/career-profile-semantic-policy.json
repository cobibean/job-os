{
  "schemaVersion": 1,
  "classification": "synthetic-semantic-contract",
  "activation": "dormant",
  "evidencePolicy": {
    "role": "optional_provenance",
    "absenceIsDefect": false,
    "acceptedContentRequiresEvidence": false,
    "removedEvidenceDemotesAcceptedContent": false,
    "permittedHealthDimensions": [
      "pending_review",
      "conflict",
      "source_changed",
      "review_suggested"
    ],
    "forbiddenEvidenceAbsenceEffects": [
      "health_score_penalty",
      "required_task",
      "filter_exclusion",
      "generation_exclusion"
    ]
  },
  "contextContract": {
    "modes": [
      "none",
      "selected",
      "broader"
    ],
    "selectedKinds": [
      "item",
      "area"
    ],
    "rules": [
      "bind_exact_scope_before_dispatch",
      "preserve_scope_on_retry_recovery_continuation",
      "fail_closed_on_unauthorized_expansion",
      "treat_profile_text_as_non_executable"
    ],
    "examples": [
      {
        "id": "none",
        "authorization": {
          "mode": "none",
          "selectedItemIds": [],
          "selectedAreas": []
        },
        "projectedItemIds": [],
        "expected": "allowed"
      },
      {
        "id": "selected-items",
        "authorization": {
          "mode": "selected",
          "selectedItemIds": [
            "cpi_FAKE_selected_0001"
          ],
          "selectedAreas": []
        },
        "projectedItemIds": [
          "cpi_FAKE_selected_0001"
        ],
        "expected": "allowed"
      },
      {
        "id": "selected-area",
        "authorization": {
          "mode": "selected",
          "selectedItemIds": [],
          "selectedAreas": [
            "what_im_looking_for"
          ]
        },
        "projectedItemIds": [
          "cpi_FAKE_work_preference_0001"
        ],
        "expected": "allowed"
      },
      {
        "id": "broader-authorized",
        "authorization": {
          "mode": "broader",
          "selectedItemIds": [],
          "selectedAreas": [
            "my_career",
            "what_im_looking_for",
            "my_evidence"
          ]
        },
        "projectedItemIds": [
          "cpi_FAKE_claim_00000001",
          "cpi_FAKE_work_preference_0001"
        ],
        "expected": "allowed"
      },
      {
        "id": "unauthorized-expansion",
        "authorization": {
          "mode": "selected",
          "selectedItemIds": [
            "cpi_FAKE_selected_0001"
          ],
          "selectedAreas": []
        },
        "requested": {
          "mode": "broader",
          "selectedItemIds": [],
          "selectedAreas": [
            "my_career",
            "what_im_looking_for"
          ]
        },
        "projectedItemIds": [],
        "expected": "fail_closed"
      }
    ],
    "retryRecoveryExample": {
      "initialScopeExampleId": "selected-items",
      "retryScopeExampleId": "selected-items",
      "recoveryScopeExampleId": "selected-items",
      "continuationScopeExampleId": "selected-items",
      "expected": "same_bound_scope"
    }
  },
  "exportContract": {
    "explicitEvidenceChoiceRequired": true,
    "defaultEvidenceMode": null,
    "modes": [
      "profile_only",
      "profile_plus_selected_evidence",
      "profile_plus_all_evidence"
    ],
    "examples": [
      {
        "id": "profile-only",
        "mode": "profile_only",
        "selectedEvidenceIds": [],
        "includedEvidenceIds": []
      },
      {
        "id": "selected-evidence",
        "mode": "profile_plus_selected_evidence",
        "selectedEvidenceIds": [
          "cpe_FAKE_source_000001"
        ],
        "includedEvidenceIds": [
          "cpe_FAKE_source_000001"
        ]
      },
      {
        "id": "all-evidence-explicit",
        "mode": "profile_plus_all_evidence",
        "selectedEvidenceIds": [],
        "includedEvidenceIds": [
          "cpe_FAKE_source_000001",
          "cpe_FAKE_source_000002"
        ]
      }
    ]
  },
  "semanticFixtures": [
