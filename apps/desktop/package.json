{
  "name": "@jobos/desktop",
  "version": "0.1.0",
  "description": "Local-first desktop workbench for job-search workflows, documents, and agent-assisted research.",
  "author": "Cobi",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobibean/job-os.git"
  },
  "homepage": "https://github.com/cobibean/job-os#readme",
  "bugs": {
    "url": "https://github.com/cobibean/job-os/issues"
  },
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "pnpm build:electron && vite build",
    "build:docx-helper": "node scripts/build-docx-atomic-replace.mjs",
    "build:electron": "pnpm build:docx-helper && pnpm --filter @jobos/docx-engine build && pnpm --filter @jobos/docx-editor-core build && node scripts/verify-docx-package-exports.mjs && tsc -p tsconfig.electron.json && node scripts/verify-preload-artifact.mjs",
    "build:keychain-helper": "node scripts/build-keychain-helper.mjs",
    "dev": "pnpm build:electron && concurrently --kill-others --success first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist/main/main.js\"",
    "lint": "oxlint src vite.config.ts",
    "package:mac": "pnpm build:keychain-helper && pnpm build && electron-builder --mac dir --arm64 && node scripts/sign-and-zip-mac.mjs",
    "package:macbook-update": "node scripts/create-macbook-update.mjs",
    "start": "electron dist/main/main.js",
    "test": "pnpm build:electron && vitest run",
    "typecheck": "pnpm --filter @jobos/docx-engine build && pnpm --filter @jobos/docx-editor-core build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@jobos/docx-editor-core": "workspace:*",
    "@jobos/docx-engine": "workspace:*",
    "@jobos/contracts": "workspace:*",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/extension-unique-id": "3.29.2",
    "@tiptap/html": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "docx": "9.7.1",
    "docx-preview": "0.4.0",
    "fast-xml-parser": "5.10.1",
    "happy-dom": "20.11.2",
    "jszip": "3.10.1",
    "lucide-react": "1.25.0",
    "mammoth": "1.12.0",
    "pagedjs": "0.4.3",
    "pdfjs-dist": "6.1.200",
    "prosemirror-docx": "0.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "sanitize-html": "2.17.6",
    "tiptap-pagination-plus": "3.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1",
    "oxlint": "1.74.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.0.10"
  },
  "build": {
    "appId": "com.cobibean.jobos",
    "productName": "JobOS",
    "asar": true,
    "directories": {
      "output": "../../release/desktop"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/jobos-keychain",
        "to": "jobos-keychain"
      },
      {
        "from": "build/jobos-docx-atomic-replace",
        "to": "jobos-docx-atomic-replace"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../../packages/docx-engine/LICENSE",
        "to": "licenses/docx-engine/LICENSE"
      },
      {
        "from": "../../packages/docx-engine/NOTICE",
        "to": "licenses/docx-engine/NOTICE"
      },
      {
        "from": "../../packages/docx-engine/UPSTREAM.md",
        "to": "licenses/docx-engine/UPSTREAM.md"
      },
      {
        "from": "../../packages/docx-editor-core/LICENSE",
        "to": "licenses/docx-editor-core/LICENSE"
      },
      {
        "from": "../../packages/docx-editor-core/NOTICE",
        "to": "licenses/docx-editor-core/NOTICE"
      },
      {
        "from": "../../packages/docx-editor-core/UPSTREAM.md",
        "to": "licenses/docx-editor-core/UPSTREAM.md"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
