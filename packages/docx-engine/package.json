{
  "name": "@jobos/docx-engine",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Pinned OOXML-retaining DOCX parser and patch engine for JobOS",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "boundary": "node scripts/assert-source-boundary.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/generate-fixtures.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
